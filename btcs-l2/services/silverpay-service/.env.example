# All values below are examples. Do not commit real credentials or cookies.
SILVERPAY_BIND_HOST=127.0.0.1
SILVERPAY_PORT=3002
SILVERPAY_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173
SILVERPAY_CACHE_TTL_MS=4000

# BTCS L1 Core RPC. Prefer a cookie file for a local node.
SILVERPAY_L1_RPC_URL=http://127.0.0.1:18443
# SILVERPAY_L1_COOKIE_FILE=/path/to/datadir/regtest/.cookie
# Alternatively, set both user and password. Do not set one without the other.
# SILVERPAY_L1_RPC_USER=
# SILVERPAY_L1_RPC_PASS=
SILVERPAY_L1_TIMEOUT_MS=5000

# BTCS L2 EVM JSON-RPC. The service only calls the read-only methods in its allowlist.
SILVERPAY_L2_RPC_URL=http://127.0.0.1:8545
SILVERPAY_L2_TIMEOUT_MS=5000
